---
import '../styles/global.css';
import site from '../data/site.json';
import data from '../data/products.json';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Products from '../components/Products.astro';
import Sell from '../components/Sell.astro';
import Thursday from '../components/Thursday.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import Assistant from '../components/Assistant.astro';

import { asset, base } from '../lib/url';
// Absolute URLs: og:image/og:url/canonical müssen inkl. Domain sein (WhatsApp-, Instagram-, Google-Vorschau)
const pageUrl = new URL(base, Astro.site).href;
const ogImage = new URL(asset('images/hero_bay.webp'), Astro.site).href;

// JSON-LD: Organisation + Angebotsliste (SEO)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: pageUrl,
  sameAs: Object.values(site.links),
  description: site.description,
};
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{site.title}</title>
  <meta name="description" content={site.description} />
  <meta name="theme-color" content="#3f4a3c" />
  <meta property="og:title" content="eskadronverkauf – Deine Lieblingsmarken. Ein zweites Leben." />
  <meta property="og:description" content={site.description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={pageUrl} />
  <link rel="canonical" href={pageUrl} />
  <meta name="robots" content="index, follow" />
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  <link rel="preload" as="image" href={asset('images/palomino.webp')} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#angebote">Zum Inhalt springen</a>
  <Header />
  <Hero />
  <Products id="angebote" over="Aktuelle Angebote" title="Finde deine" titleSer="Farbwelt" products={data.products.filter(p => !p.fresh)} showWorlds={true} />
  <Sell />
  <Products id="drops" over="Frisch eingetroffen" title="Fresh" titleSer="Drops" products={data.products.filter(p => p.fresh)} showWorlds={false} />
  <Thursday />
  <About />
  <Footer />
  <Assistant />
  <script>
    // Scroll-Reveal
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));

    // Farbwelten-Filter
    document.querySelectorAll('.world').forEach((chip) => chip.addEventListener('click', () => {
      document.querySelectorAll('.world').forEach((c) => c.classList.toggle('on', c === chip));
      const w = (chip as HTMLElement).dataset.world;
      document.querySelectorAll('.grid').forEach((grid) => {
        let visible = 0;
        grid.querySelectorAll('.card').forEach((card) => {
          const hide = w !== 'all' && (card as HTMLElement).dataset.world !== w;
          card.classList.toggle('hide', hide);
          if (!hide) visible++;
        });
        let empty = grid.querySelector('.grid-empty');
        if (!empty) {
          empty = document.createElement('p');
          empty.className = 'grid-empty';
          empty.textContent = 'In dieser Farbwelt ist gerade nichts da – stell uns gern einen Suchauftrag.';
          grid.appendChild(empty);
        }
        grid.classList.toggle('empty', visible === 0);
      });
    }));
  </script>
</body>
</html>
