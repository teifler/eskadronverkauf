---
import site from '../data/site.json';
import products from '../data/products.json';
import { base } from '../lib/url';
const hasDemo = products.products.some((p) => p.demo);
const r = site.review;
---
<footer>
  <div class="cols">
    <div>
      <h4>eskadron✶verkauf</h4>
      <p style="font-size:13px;line-height:1.8;max-width:30ch">Farbenfrohe Second-Hand-Sets für Pferd &amp; Reiter:in.</p>
    </div>
    <div>
      <h4>Shop</h4>
      <a href={`${base}#angebote`}>Farbwelten</a>
      <a href={`${base}#drops`}>Fresh Drops</a>
    </div>
    <div>
      <h4>Service</h4>
      <a href={`${base}#verkaufen`}>Verkaufen</a>
      <a href={`${base}#wunsch`}>Wunschstück</a>
    </div>
    <div>
      <h4>Social</h4>
      <a href={site.links.instagram} target="_blank" rel="noopener">Instagram</a>
      <a href={site.links.tiktok} target="_blank" rel="noopener">TikTok</a>
      <a href={site.links.vinted} target="_blank" rel="noopener">Vinted</a>
      <a href={site.links.kleinanzeigen} target="_blank" rel="noopener">Kleinanzeigen</a>
    </div>
    <div>
      <h4>Rechtliches</h4>
      <a href={`${base}impressum/`}>Impressum</a>
      <a href={`${base}datenschutz/`}>Datenschutz</a>
    </div>
  </div>
  <p class="fine">
    {hasDemo && <>Demo-Artikel sind gekennzeichnet und zeigen Symbolfotos (Unsplash) · </>}
    „Geprüft“ heißt: von uns persönlich auf Zustand und Mängel angesehen ·
    Markennamen beschreiben gebrauchte Originalartikel – wir sind kein offizieller Händler und stehen in keiner Verbindung zu den Markeninhabern
    {r.rating && r.count && <> · Die Bewertung oben stammt aus unserem Vinted-Profil; wir haben keinen Einfluss auf diese Bewertungen und prüfen nicht selbst, ob sie von echten Käufer:innen stammen</>}
  </p>
</footer>
