---
import { asset } from '../lib/url';
---
<div class="hero" id="top">
  <div class="hero-grid">
    <div class="cell c-txt">
      <span class="kick">Reitsport Second Hand</span>
      <h1 class="h1">Matchy, matchy – <span class="ser">aber nachhaltig.</span></h1>
      <p class="lead">Farblich kuratierte Second-Hand-Sets von Eskadron, Kentucky &amp; Co. Premium-Qualität, kleiner Preis, großes Farbglück.</p>
      <div class="ctas">
        <a class="btn fill" href="#angebote">Farbwelten entdecken<span class="ar">→</span></a>
        <button class="btn terra" data-open="sell">Set verkaufen</button>
      </div>
    </div>
    <div class="cell c1 rv"><img src={asset('images/palomino.webp')} width="1100" height="1649" alt="Palomino auf sonniger Weide – warme Naturfarben" fetchpriority="high" /></div>
    <div class="cell c2 rv" aria-hidden="true"></div>
    <div class="cell c3 rv"><img src={asset('images/flatlay.webp')} width="1000" height="751" alt="Rosafarbenes Accessoire-Flatlay" loading="lazy" /></div>
    <div class="cell c4 rv" aria-hidden="true">
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <path id="circ" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" fill="none" />
        <text style="font-size:11.5px;letter-spacing:2.5px;fill:#6d4038;font-family:Trebuchet MS,Verdana,sans-serif;font-weight:700">
          <textPath href="#circ">PRELOVED · GEPRÜFT · PRELOVED · GEPRÜFT ·</textPath>
        </text>
      </svg>
    </div>
  </div>
</div>
