---
import { asset } from '../lib/url';
---
<section id="verkaufen" aria-label="Verkaufen">
  <div class="duo">
    <div class="imgs rv">
      <img class="i1" src={asset('images/chestnut.webp')} width="1000" height="1500" alt="Fuchs-Porträt in warmen Tönen" loading="lazy" />
      <img class="i2" src={asset('images/brown_port.webp')} width="1000" height="1518" alt="Braunes Pferd mit Halfter" loading="lazy" />
    </div>
    <div class="rv">
      <span class="kick">Ankauf &amp; Kommission</span>
      <h3>Deine Reitsportsachen verdienen <span class="ser">ein zweites Leben.</span></h3>
      <p>Schick uns ein paar Fotos und Informationen. Wir schauen uns deine Artikel an und melden uns bei dir – mit Direktankaufs-Angebot oder Kommissionsvorschlag.</p>
      <p style="font-size:13.5px">Bitte erst nach unserer Freigabe versenden – wir prüfen jedes Teil persönlich auf Zustand und Mängel, bevor es in den Verkauf geht.</p>
      <div class="pillrow">
        <span class="pill g">✓ Direkt an uns verkaufen</span>
        <span class="pill">✓ Für dich verkaufen lassen</span>
      </div>
      <div style="margin-top:22px"><button class="btn fill" data-open="sell">Fotos einreichen<span class="ar">→</span></button></div>
      <div class="howto">
        <div class="how"><span class="n">1</span><b>Fotos einreichen</b><p>Formular ausfüllen, bis zu 6 Fotos hochladen – fertig.</p></div>
        <div class="how"><span class="n">2</span><b>Angebot erhalten</b><p>Wir melden uns mit Ankaufspreis oder Kommissionsvorschlag.</p></div>
        <div class="how"><span class="n">3</span><b>Erst dann senden</b><p>Versand erst nach Freigabe – wir prüfen jedes Teil persönlich auf Zustand.</p></div>
      </div>
    </div>
  </div>
</section>
